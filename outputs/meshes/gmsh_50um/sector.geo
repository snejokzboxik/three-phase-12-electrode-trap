// Metres. Sector [-15, +15] degrees; no electrostatic seam BCs.
SetFactory("Built-in");
R = 0.025000000000000001; r = 0.01; a = 0.0015;
h = 5.0000000000000002e-05; ho = 0.00025000000000000001;
Point(1) = {0, 0, 0, h};
Point(2) = {R*Cos(-Pi/12), R*Sin(-Pi/12), 0, ho};
Point(3) = {R*Cos(Pi/12), R*Sin(Pi/12), 0, ho};
Line(1) = {1, 2};
Circle(2) = {2, 1, 3};
Line(3) = {1, 3};
Curve Loop(1) = {1, 2, -3};
Point(4) = {r, 0, 0, h};
Point(5) = {r+a, 0, 0, h};
Point(6) = {r, a, 0, h};
Point(7) = {r-a, 0, 0, h};
Point(8) = {r, -a, 0, h};
Circle(4) = {5, 4, 6};
Circle(5) = {6, 4, 7};
Circle(6) = {7, 4, 8};
Circle(7) = {8, 4, 5};
Curve Loop(2) = {4, 5, 6, 7};
Plane Surface(1) = {1, 2};
Physical Surface("vacuum", 100) = {1};
Physical Curve("outer", 1) = {2};
Physical Curve("electrode_0", 10) = {4, 5, 6, 7};
Periodic Curve {3} = {1} Rotate {{0,0,1}, {0,0,0}, Pi/6};
Field[1] = MathEval;
Field[1].F = "5.0000000000000002e-05+(0.00025000000000000001-5.0000000000000002e-05)*Min(1,Max(0,(Sqrt(x*x+y*y)-0.0080000000000000002)/(0.014-0.0080000000000000002)))";
Field[2] = Distance;
Field[2].CurvesList = {4,5,6,7};
Field[2].Sampling = 400;
Field[3] = Threshold;
Field[3].InField = 2;
Field[3].SizeMin = h;
Field[3].SizeMax = ho;
Field[3].DistMin = 0.0001;
Field[3].DistMax = 0.002;
Field[4] = Min;
Field[4].FieldsList = {1,3};
Background Field = 4;
Mesh.MeshSizeFromPoints = 0;
Mesh.MeshSizeFromCurvature = 0;
Mesh.MeshSizeExtendFromBoundary = 0;
Mesh.MeshSizeMin = h;
Mesh.MeshSizeMax = ho;
Mesh.MeshSizeFactor = 1;
Mesh.ElementOrder = 1;
Mesh.Algorithm = 6;
Mesh.RandomSeed = 12345;
General.NumThreads = 1;
